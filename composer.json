{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "stanislas-poisson/french-postal-code",
    "description": "The regions, departments, communes and postal codes of France, with one GPS point per postal code: the data, the models and a loader for Laravel and Symfony.",
    "type": "library",
    "keywords": [
        "france",
        "postal-code",
        "insee",
        "gps",
        "geocoding",
        "open-data",
        "dataset",
        "communes",
        "laravel",
        "symfony",
        "doctrine",
        "eloquent"
    ],
    "license": "MIT",
    "homepage": "https://github.com/Stanislas-Poisson/French-Postal-Code-Package",
    "authors": [
        {
            "name": "Stanislas Poisson",
            "email": "stanislas.p@the-white-rabbits.fr",
            "homepage": "https://github.com/Stanislas-Poisson",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/Stanislas-Poisson/French-Postal-Code-Package/issues",
        "source": "https://github.com/Stanislas-Poisson/French-Postal-Code-Package",
        "docs": "https://github.com/Stanislas-Poisson/French-Postal-Code-Package#readme",
        "security": "https://github.com/Stanislas-Poisson/French-Postal-Code-Package/security/policy"
    },
    "funding": [
        {
            "type": "patreon",
            "url": "https://www.patreon.com/c/zairakai"
        },
        {
            "type": "other",
            "url": "https://www.twitch.tv/zairakai"
        }
    ],
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "stanislas-poisson/php-dev-tools": "dev-develop"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Stanislas-Poisson/php-dev-tools"
        }
    ],
    "suggest": {
        "laravel/framework": "Eloquent models and Artisan command (11 to 13)",
        "symfony/framework-bundle": "Doctrine entities and console command (6.4, 7.4 or 8)",
        "doctrine/orm": "Needed by the Symfony adapter (3.x, with DBAL 4)",
        "doctrine/doctrine-bundle": "Needed by the Symfony adapter",
        "symfony/var-exporter": "Needed by Doctrine ORM to load a relation on demand, below PHP 8.4"
    },
    "conflict": {
        "laravel/framework": "<11.0",
        "symfony/framework-bundle": "<6.4",
        "doctrine/orm": "<3.0",
        "doctrine/dbal": "<4.0"
    },
    "autoload": {
        "psr-4": {
            "StanislasPoisson\\FrenchPostalCode\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "StanislasPoisson\\FrenchPostalCode\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "php-dev-tools analyse",
        "analyse:laravel": "phpstan analyse --configuration=phpstan-laravel.neon --memory-limit=1G",
        "analyse:symfony": "phpstan analyse --configuration=phpstan-symfony.neon --memory-limit=1G",
        "cs": "php-dev-tools cs",
        "cs:fix": "php-dev-tools cs:fix",
        "insights": "php-dev-tools insights",
        "markdown": "php-dev-tools markdown",
        "quality": [
            "php-dev-tools quality",
            "@test"
        ],
        "quality:fast": "php-dev-tools quality:fast",
        "quality:fix": "php-dev-tools quality:fix",
        "rector": "php-dev-tools rector",
        "rector:fix": "php-dev-tools rector:fix",
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text",
        "test:laravel": "phpunit --configuration=phpunit.laravel.xml",
        "test:symfony": "phpunit --configuration=phpunit.symfony.xml"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "process-timeout": 0
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "StanislasPoisson\\FrenchPostalCode\\Laravel\\FrenchPostalCodeServiceProvider"
            ]
        },
        "authors": [
            {
                "email": [
                    "stanislas.p@the-white-rabbits.fr"
                ],
                "name": "Stanislas Poisson",
                "notes": "Primary maintainer",
                "social": {
                    "github": "https://github.com/Stanislas-Poisson",
                    "gitlab": "https://gitlab.com/zairakai",
                    "linkedin": "https://www.linkedin.com/in/stanislasp/",
                    "stanislas-poisson": "https://stanislas-poisson.fr",
                    "the-white-rabbits": "https://the-white-rabbits.fr",
                    "twitch": "https://twitch.tv/zairakai"
                }
            }
        ]
    }
}
