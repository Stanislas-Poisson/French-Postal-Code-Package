# The core and the Symfony adapter. Needs Symfony and Doctrine: see scripts/install-symfony.sh.
includes:
    - phpstan-frameworks.neon
    - vendor/phpstan/phpstan-doctrine/extension.neon

parameters:
    paths:
        - src/Core
        - src/Symfony
        - tests/Core
        - tests/Support
        - tests/Symfony
    tmpDir: build/phpstan-symfony
