# The core and the Laravel adapter. Needs Laravel and Larastan: see scripts/install-laravel.sh.
includes:
    - phpstan-common.neon
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - src/Core
        - src/Laravel
        - tests/Core
        - tests/Support
        - tests/Laravel
    tmpDir: build/phpstan-laravel
