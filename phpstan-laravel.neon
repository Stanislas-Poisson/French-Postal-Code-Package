# The core and the Laravel adapter. Needs Laravel and Larastan: see scripts/install-laravel.sh.
includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: max
    paths:
        - src/Core
        - src/Laravel
        - tests/Core
        - tests/Support
        - tests/Laravel
    tmpDir: build/phpstan-laravel
    checkMissingCallableSignature: true
    checkTooWideReturnTypesInProtectedAndPublicMethods: true
    checkUninitializedProperties: true
    reportUnmatchedIgnoredErrors: true
